# ---- Bizula API (server/) ----
# Copy to server/.env and fill in real values. Never commit server/.env.

# Runtime
NODE_ENV=development
PORT=5000

# Required: MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/bizula

# Required: long random string (>= 32 chars in production). e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins (frontend URLs)
CLIENT_URL=http://localhost:5173

# Public URL of the frontend, used to build referral links, reset links, payment callbacks
APP_URL=http://localhost:5173

# Billing (Paystack). Leave empty to disable checkout (API returns 503 "not configured").
PAYSTACK_SECRET_KEY=
# Override only for testing against a mock server
PAYSTACK_BASE_URL=https://api.paystack.co

# When "true", inventory/sales write actions require an active subscription.
# Default "false" until pricing and trial rules are confirmed by the product owner.
SUBSCRIPTION_ENFORCEMENT=false

# Outgoing email for password reset (SMTP). Leave SMTP_HOST empty to disable email;
# the forgot-password endpoint will then answer 503 and admins can issue reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Bizula <no-reply@example.com>"

# Rate limiting for /api/auth (requests per window per IP)
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Set to 1 when running behind a reverse proxy/load balancer (Render, Railway, Nginx)
TRUST_PROXY=0
